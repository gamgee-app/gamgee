{
  "name": "gamgee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@gamgee/web",
    "dev:server": "npm run dev --workspace=@gamgee/server",
    "build": "npm run build --workspace=@gamgee/server && npm run build --workspace=@gamgee/web",
    "start": "npm run start --workspace=@gamgee/server",
    "lint": "npm run lint --workspaces --if-present",
    "fix": "npm run fix --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "typescript": "~5.6.2"
  }
}
